{
  "manifest_version": 3,
  "name": "Jarvis Poster",
  "version": "1.3.0",
  "description": "Post one video to TikTok, Instagram and YouTube at once, using the accounts you're already logged in to.",
  "action": {
    "default_title": "Open Jarvis Poster",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*", "https://www.instagram.com/*", "https://studio.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
